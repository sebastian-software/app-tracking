{
  "name": "@sebastian-software/app-tracking",
  "version": "0.7.0",
  "description": "Consent-gated usage reporting and verified downloads for Node.js",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-software/app-tracking.git",
    "directory": "packages/node-client"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-node-client.ts",
    "test": "node --test test/*.test.cjs"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  }
}
