{
  "name": "@sebastian-software/app-tracking",
  "version": "0.6.0",
  "private": true,
  "description": "Shared version delivery and opt-in usage tracking for developer tools",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build.ts",
    "build:node-client": "node scripts/build-node-client.ts",
    "test:node-client": "pnpm build:node-client && node --test packages/node-client/test/*.test.cjs",
    "test": "node --test test/*.test.ts test/storage/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && node scripts/check-build.ts && node scripts/storage/build-proof.ts && node scripts/storage/build-ingestion.ts && node scripts/check-ingestion-build.ts",
    "smoke:upstreams": "node scripts/smoke-upstreams.ts",
    "db:migrate": "node scripts/storage/migrate.ts",
    "test:storage": "node test/storage/run.ts"
  },
  "devDependencies": {
    "@bunny.net/edgescript-sdk": "0.13.0",
    "@neondatabase/serverless": "1.2.0",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@workos-inc/node": "12.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "jose": "6.2.13",
    "oxfmt": "0.74.0",
    "playwright": "1.62.1",
    "proper-lockfile": "4.1.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "packageManager": "pnpm@12.16.0"
}
